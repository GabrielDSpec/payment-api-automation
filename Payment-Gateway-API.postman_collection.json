              "name": "Auth Base (For Partial Refund)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status Code deve ser 200 OK - Venda Base Criada\", function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});\r",
                      "\r",
                      "// Salva o ID apenas se a venda for aprovada\r",
                      "if (pm.response.code === 200) {\r",
                      "    var jsonData = pm.response.json();\r",
                      "    pm.variables.set(\"partialChargeId\", jsonData.id);\r",
                      "    console.log(\"SUCESSO: ID para Estorno Parcial gerado -> \" + jsonData.id);\r",
                      "} else {\r",
                      "    console.log(\"ALERTA: A Venda Base falhou -> \", pm.response.json());\r",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
