        {
          "name": "Create Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status Code deve ser 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "if (pm.response.code === 201) {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.environment.set(\"orderId\", jsonData.id);\r",
                  "    console.log(\"ID salvo: \" + jsonData.id);\r",
                  "    \r",
                  "    // Validação segura\r",
                  "    pm.test(\"Valor capturado deve ser igual ao enviado\", function () {\r",
                  "        pm.expect(jsonData.purchase_units[0].amount.value).to.not.be.undefined;\r",
                  "    });\r",
                  "}\r",
                  "\r",
                  "pm.test(\"Status de captura\", function () {\r",
                  "    if (pm.response.code !== 201 && pm.response.code !== 200) {\r",
                  "        console.log(\"Erro no Capture: \" + pm.response.text());\r",
                  "    }\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypal_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
