        {
          "name": "Capture Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verificação do fluxo de captura\", function () {\r",
                  "    // 1. Caso de sucesso (se a conta permitir)\r",
                  "    if (pm.response.code === 200 || pm.response.code === 201) {\r",
                  "        pm.expect(true).to.be.true;\r",
                  "    } \r",
                  "    // 2. Caso de bloqueio de segurança (Sandbox padrão)\r",
                  "    else if (pm.response.code === 422) {\r",
                  "        var jsonData = pm.response.json();\r",
                  "        pm.expect(jsonData.details[0].issue).to.eql(\"ORDER_NOT_APPROVED\");\r",
                  "        console.log(\"Fluxo validado: Captura bloqueada corretamente por falta de aprovação (Security Policy).\");\r",
                  "    } \r",
                  "    else {\r",
                  "        pm.expect.fail(\"Falha inesperada no Capture: \" + pm.response.text());\r",
                  "    }\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
