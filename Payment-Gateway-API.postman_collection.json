                      "\r",
                      "pm.test(\"A mensagem de erro deve ser de Saldo Insuficiente\", function () {\r",
                      "    var jsonData = pm.response.json();\r",
                      "    pm.expect(jsonData.error.type).to.eql(\"card_error\");\r",
                      "    pm.expect(jsonData.error.decline_code).to.eql(\"insufficient_funds\");\r",
