            {
              "name": "Refund Transaction",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// 1. Valida se o estorno foi aceito pelo gateway\r",
                      "pm.test(\"Status Code deve ser 200 OK - Estorno Realizado\", function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});\r",
                      "\r",
                      "// 2. Valida se o objeto retornado é realmente um estorno\r",
                      "pm.test(\"O objeto retornado deve ser do tipo 'refund'\", function () {\r",
                      "    var jsonData = pm.response.json();\r",
                      "    pm.expect(jsonData.object).to.eql(\"refund\");\r",
                      "});\r",
                      "\r",
                      "// 3. Valida se o status do estorno é sucesso\r",
                      "pm.test(\"O status do estorno deve ser 'succeeded'\", function () {\r",
                      "    var jsonData = pm.response.json();\r",
                      "    pm.expect(jsonData.status).to.eql(\"succeeded\");\r",
                      "});\r",
                      "\r",
                      "// 4. Valida se o estorno foi aplicado na cobrança correta (Cross-Validation)\r",
                      "pm.test(\"O ID da cobrança estornada deve ser o mesmo da Autorização\", function () {\r",
                      "    var jsonData = pm.response.json();\r",
                      "    var chargeOriginal = pm.variables.get(\"stripeChargeId\");\r",
                      "    \r",
                      "    pm.expect(jsonData.charge).to.eql(chargeOriginal);\r",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
