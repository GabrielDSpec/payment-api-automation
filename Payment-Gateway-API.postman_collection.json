    {
      "name": "Stripe API",
      "item": [
        {
          "name": "Authorization Flow",
          "item": [
            {
              "name": "Credit Card Authorization",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "// 1. Valida se a requisição foi um sucesso\r",
                      "pm.test(\"Status Code deve ser 200 OK\", function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});\r",
                      "\r",
                      "// 2. Valida a performance (missão crítica em pagamentos)\r",
                      "pm.test(\"Tempo de resposta deve ser menor que 800ms\", function () {\r",
                      "    pm.expect(pm.response.responseTime).to.be.below(800);\r",
                      "});\r",
                      "\r",
                      "// 3. Valida se o servidor processou os dados corretamente\r",
                      "pm.test(\"O valor da transação deve estar correto no retorno\", function () {\r",
                      "    var jsonData = pm.response.json();\r",
                      "    // O postman-echo devolve os dados dentro de um objeto chamado 'data'\r",
                      "    pm.expect(jsonData.data.amount).to.eql(150.00);\r",
                      "    pm.expect(jsonData.data.payment_method.card_brand).to.eql(\"Mastercard\");\r",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{stripe_api_key}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": []
                },
                "url": {
                  "raw": "https://api.stripe.com/v1/charges",
                  "protocol": "https",
                  "host": [
                    "api",
                    "stripe",
                    "com"
                  ],
                  "path": [
                    "v1",
                    "charges"
                  ]
                }
              },
              "response": []
            }
          ]
        }
      ]
    },
    {
      "name": "Mercado Pago API",
      "item": []
    }
